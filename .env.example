# GEMINI_API_KEY: Required for Gemini AI API calls (redação evaluation).
# Get a key at https://aistudio.google.com/apikey
#
# Local dev: copy this file to .env and fill in the real value (server.ts uses dotenv).
# Vercel: set this in Project Settings > Environment Variables (or `vercel env add`).
# Do NOT commit the real key — .env is already gitignored.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase: required for login and cloud sync of user progress.
# Get these from Supabase Dashboard > Project Settings > API.
# The anon key is safe to expose client-side — access is enforced by Row Level Security.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# SUPABASE_SECRET_KEY: service-role (secret) key, SERVER-SIDE ONLY — never expose
# it to the browser and never prefix it with VITE_, or Vite will inline it into
# the bundle. It writes the daily AI-evaluation counter, which users are not
# allowed to write themselves (see supabase/schema.sql).
# Without it the redação endpoint returns 503 instead of grading, by design:
# unmetered Gemini calls on a one-time-payment product have no cost ceiling.
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"
